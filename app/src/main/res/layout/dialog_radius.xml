<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选择搜索范围"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- 当前范围显示 -->
    <TextView
        android:id="@+id/radiusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 公里"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- 滑块 -->
    <com.google.android.material.slider.Slider
        android:id="@+id/radiusSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.5"
        android:valueTo="50"
        app:trackHeight="8dp"
        app:thumbRadius="12dp"
        app:haloRadius="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="滑动调整范围 (0.5 - 50 公里)"
        android:textSize="13sp"
        android:textColor="@color/gray"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_gray"
        android:layout_marginVertical="8dp" />

    <!-- 预设选项 - 使用 ChipGroup 自动换行 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="快速选择"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/presetChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/preset500m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="500米"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset1km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1公里"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset2km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2公里"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset5km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5公里"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset10km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10公里"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset20km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20公里"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset50km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50公里"
            android:textSize="14sp"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

    </com.google.android.material.chip.ChipGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_gray"
        android:layout_marginVertical="16dp" />

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="确定"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

</LinearLayout>
